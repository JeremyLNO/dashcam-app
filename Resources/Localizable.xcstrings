    "settings.auto_export.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last automatic export failed. The footage is still protected inside the app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dernier export automatique a échoué. Les images restent protégées dans l'app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La última exportación automática falló. Las imágenes siguen protegidas en la app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der letzte automatische Export ist fehlgeschlagen. Das Material bleibt in der App geschützt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A última exportação automática falhou. As imagens continuam protegidas na app."
          }
        }
      }
    },
    "settings.auto_export.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a drive ends, each protected moment is exported on its own — ten seconds either side of an impact, not the whole drive — and saved to Photos. Off by default, and never twice for the same event."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À la fin d'un trajet, chaque moment protégé est exporté seul — dix secondes de part et d'autre d'un choc, pas le trajet entier — et enregistré dans Photos. Désactivé par défaut, et jamais deux fois pour le même événement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al terminar un trayecto, cada momento protegido se exporta por separado — diez segundos antes y después de un impacto, no todo el trayecto — y se guarda en Fotos. Desactivado por defecto y nunca dos veces para el mismo evento."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am Ende einer Fahrt wird jeder geschützte Moment einzeln exportiert — zehn Sekunden vor und nach einem Aufprall, nicht die ganze Fahrt — und in Fotos gesichert. Standardmäßig aus, und nie zweimal für dasselbe Ereignis."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "No fim de uma viagem, cada momento protegido é exportado sozinho — dez segundos antes e depois de um embate, não a viagem inteira — e guardado em Fotos. Desligado por omissão, e nunca duas vezes para o mesmo evento."
          }
        }
      }
    },
    "settings.auto_export.needs_photos": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos access is denied, so the files stay inside the app. You can still share them from a drive."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès à Photos est refusé : les fichiers restent dans l'app. Vous pouvez toujours les partager depuis un trajet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a Fotos está denegado: los archivos se quedan en la app. Puedes compartirlos desde un trayecto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zugriff auf Fotos ist verweigert: die Dateien bleiben in der App. Du kannst sie weiterhin aus einer Fahrt teilen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso a Fotos está negado: os ficheiros ficam na app. Pode sempre partilhá-los a partir de uma viagem."
          }
        }
      }
    },
