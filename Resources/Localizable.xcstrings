    "paywall.trial.export_note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Während der Testphase kannst du aufnehmen, ansehen und löschen. Der Export wird mit Beginn des Abos freigeschaltet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "During the free trial you can record, review and delete. Export unlocks when the subscription starts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante la prueba gratuita puedes grabar, revisar y eliminar. La exportación se desbloquea al iniciar la suscripción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendant l'essai gratuit vous pouvez enregistrer, consulter et supprimer. L'export se débloque au début de l'abonnement."
          }
        },
        "pt": {
