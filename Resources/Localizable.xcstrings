    "a11y.dim_hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dunkelt das Display ab. Die Aufnahme läuft weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turns the display down. The drive keeps recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja el brillo. La grabación continúa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Baisse la luminosité. Le trajet continue d'être enregistré."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduz o brilho. A gravação continua."
          }
        }
      }
    },
