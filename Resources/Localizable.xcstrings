    "alert.protect_idle.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte zuerst die Aufnahme — Schützen bewahrt das Material um den Moment des Antippens."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start recording first — Protect keeps the footage around the moment you press it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza a grabar primero: Proteger conserva las imágenes del momento en que pulsas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrez d'abord l'enregistrement — Protéger conserve les images autour du moment où vous appuyez."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece a gravar primeiro — Proteger guarda as imagens em torno do momento em que toca."
          }
        }
      }
    },
