            "state": "translated",
            "value": "La cámara interior se desactivó. La cámara de carretera sigue grabando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La caméra habitacle a été coupée. La caméra route continue d'enregistrer."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A câmara do habitáculo foi desligada. A câmara da estrada continua a gravar."
          }
        }
      }
    },
