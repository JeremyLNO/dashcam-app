    "settings.carplay_autostart": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei CarPlay-Verbindung aufnehmen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start recording on CarPlay"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grabar al conectar CarPlay"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer à la connexion CarPlay"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Gravar ao ligar ao CarPlay"
          }
        }
      }
    },
    "settings.carplay_autostart.footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme startet von selbst, sobald das Auto verbunden ist — sofern Dashcam Pocket bereits geöffnet ist; iOS erlaubt keiner App, sich selbst zu starten. Für den Rest: Lege in Kurzbefehle eine persönliche Automation an: „Wenn CarPlay verbindet → Start Recording“, und schalte „Vor dem Ausführen fragen“ aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording starts by itself when the car is connected, as long as Dashcam Pocket is already open — iOS does not let an app launch itself. To cover the rest, create a personal automation in Shortcuts: “When CarPlay connects → Start Recording”, and turn off “Ask Before Running”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación empieza sola al conectar el coche, siempre que Dashcam Pocket ya esté abierta: iOS no permite que una app se inicie sola. Para el resto, crea una automatización personal en Atajos: «Cuando CarPlay se conecte → Start Recording», y desactiva «Preguntar antes de ejecutar»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enregistrement démarre seul à la connexion de la voiture, à condition que Dashcam Pocket soit déjà ouverte — iOS n'autorise aucune app à se lancer elle-même. Pour le reste, créez une automatisation personnelle dans Raccourcis : « Quand CarPlay se connecte → Start Recording », et désactivez « Demander avant d'exécuter »."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação começa sozinha ao ligar o carro, desde que a Dashcam Pocket já esteja aberta — o iOS não permite que uma app se inicie sozinha. Para o resto, crie uma automatização pessoal em Atalhos: «Quando o CarPlay ligar → Start Recording» e desative «Perguntar antes de executar»."
          }
        }
      }
    },
    "settings.certify": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Certify exports"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certifier les exports"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Certificar las exportaciones"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporte zertifizieren"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Certificar as exportações"
          }
        }
      }
    },
    "settings.certify.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signs an export with a key Apple vouches for, and has its fingerprint stamped by an independent time authority — so a recipient can check the file came from this app, on this iPhone, before that date. This is the only feature that uses the network, and only a fingerprint is sent: never a frame of video. Off by default."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Signe un export avec une clé dont Apple se porte garant, et fait horodater son empreinte par une autorité de temps indépendante — un destinataire peut ainsi vérifier que le fichier vient de cette app, sur cet iPhone, avant cette date. C'est la seule fonction qui utilise le réseau, et seule une empreinte est transmise : jamais une image. Désactivé par défaut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Firma una exportación con una clave avalada por Apple y hace sellar su huella por una autoridad de tiempo independiente, para que quien la reciba compruebe que el archivo viene de esta app, en este iPhone, antes de esa fecha. Es la única función que usa la red, y solo se envía una huella: nunca una imagen. Desactivado por defecto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Signiert einen Export mit einem Schlüssel, für den Apple bürgt, und lässt dessen Prüfsumme von einer unabhängigen Zeitautorität stempeln — der Empfänger kann so prüfen, dass die Datei aus dieser App, von diesem iPhone und vor diesem Datum stammt. Es ist die einzige Funktion, die das Netz nutzt, und übertragen wird nur eine Prüfsumme, nie ein Bild. Standardmäßig aus."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Assina uma exportação com uma chave pela qual a Apple responde e manda carimbar a sua impressão por uma autoridade de tempo independente — quem receber pode verificar que o ficheiro vem desta app, neste iPhone, antes dessa data. É a única função que usa a rede, e só é enviada uma impressão: nunca uma imagem. Desligado por omissão."
          }
        }
      }
    },
    "settings.discreet": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum diskreten Bildschirm"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch to discreet screen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar a pantalla discreta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passer en écran discret"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mudar para ecrã discreto"
          }
        }
      }
    },
    "settings.discreet.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The discreet screen only comes on while a drive is being recorded, and the countdown starts over with every new drive."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'écran discret ne s'active que pendant l'enregistrement d'un trajet, et le décompte repart à chaque nouveau trajet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pantalla discreta solo se activa mientras se graba un trayecto, y la cuenta atrás vuelve a empezar con cada trayecto nuevo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der diskrete Bildschirm erscheint nur während einer laufenden Aufnahme, und der Countdown beginnt mit jeder neuen Fahrt von vorn."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O ecrã discreto só aparece durante a gravação de uma viagem, e a contagem recomeça a cada nova viagem."
          }
        }
      }
    },
