    "export.style.footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufnahmen auf dem Datenträger werden nie verändert. Datum, Zeit, Position und Tempo werden als Metadaten gespeichert und nur in die exportierte Datei gerendert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recordings on disk are never modified. Date, time, position and speed are stored as metadata and only rendered into the file you export."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las grabaciones en disco nunca se modifican. Fecha, hora, posición y velocidad se guardan como metadatos y solo se incrustan en el archivo exportado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les enregistrements sur disque ne sont jamais modifiés. Date, heure, position et vitesse sont stockées en métadonnées et incrustées uniquement dans le fichier exporté."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As gravações em disco nunca são modificadas. Data, hora, posição e velocidade são guardadas como metadados e só são incrustadas no ficheiro exportado."
          }
        }
      }
    },
