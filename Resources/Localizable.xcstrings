    "export.proof.footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt eine JSON-Datei mit den Originalaufnahmen, ihren SHA-256-Prüfsummen und den Fahrtdaten bei, damit sich das Material gegen die Aufzeichnung des Geräts prüfen lässt. Sie ist nicht signiert und trägt keinen vertrauenswürdigen Zeitstempel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds a JSON file listing the original recordings with their SHA-256 digests and the drive's metadata, so the footage can be checked against what the device recorded. It is not signed and carries no trusted timestamp."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un archivo JSON con las grabaciones originales, sus huellas SHA-256 y los metadatos del trayecto, para poder verificar las imágenes frente a lo que grabó el dispositivo. No está firmado ni tiene sello de tiempo de confianza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute un fichier JSON listant les enregistrements d'origine avec leurs empreintes SHA-256 et les métadonnées du trajet, pour pouvoir vérifier les images face à ce que l'appareil a enregistré. Il n'est ni signé ni horodaté par un tiers de confiance."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona um ficheiro JSON com as gravações originais, as suas impressões SHA-256 e os metadados da viagem, para verificar as imagens face ao que o dispositivo gravou. Não é assinado nem tem selo temporal de confiança."
          }
        }
      }
    },
