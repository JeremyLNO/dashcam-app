    "mount.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold the phone in its cradle and match the white line to the dashed one. A crooked mount is only ever noticed after the accident, when the footage is already crooked."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez le téléphone dans son support et alignez la ligne blanche sur la ligne pointillée. Une fixation de travers ne se remarque qu'après l'accident, quand les images le sont déjà."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca el teléfono en su soporte y alinea la línea blanca con la discontinua. Un soporte torcido solo se nota después del accidente, cuando las imágenes ya lo están."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setz das Telefon in die Halterung und bring die weiße Linie auf die gestrichelte. Eine schiefe Halterung fällt erst nach dem Unfall auf — dann ist das Material bereits schief."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque o telefone no suporte e alinhe a linha branca com a tracejada. Um suporte torto só se nota depois do acidente, quando as imagens já estão tortas."
          }
        }
      }
    },
    "mount.level": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Horizon"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Horizon"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Horizonte"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Horizont"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Horizonte"
          }
        }
      }
    },
    "mount.tip.cabin": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the cabin camera sees the seats, not the roof."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez que la caméra avant voit les sièges, pas le plafond."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba que la cámara frontal ve los asientos, no el techo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe, dass die Innenkamera die Sitze sieht, nicht das Dach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique que a câmara frontal vê os bancos, não o tejadilho."
          }
        }
      }
    },
    "mount.tip.height": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mount it high and close to the windscreen, just below the mirror."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixez-le haut et près du pare-brise, juste sous le rétroviseur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Colócalo alto y cerca del parabrisas, justo debajo del retrovisor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring es hoch und nah an die Scheibe, knapp unter den Spiegel."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixe-o alto e perto do para-brisas, logo abaixo do espelho."
          }
        }
      }
    },
    "mount.tip.wipers": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep it inside the wiper sweep, or rain will blur every frame."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restez dans la zone balayée par les essuie-glaces, sinon la pluie brouille chaque image."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenlo dentro del barrido del limpiaparabrisas o la lluvia difuminará cada imagen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleib im Wischbereich, sonst verwischt Regen jedes Bild."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha-o dentro da zona dos limpa-para-brisas, ou a chuva desfoca cada imagem."
          }
        }
      }
    },
    "mount.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aim the camera"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Régler la fixation"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustar el soporte"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera ausrichten"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustar o suporte"
          }
        }
      }
    },
    "mount.verdict.aim": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pointing too high or too low. Tip the phone until the road fills the lower half."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop haut ou trop bas. Inclinez le téléphone jusqu'à ce que la route occupe la moitié basse."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apunta demasiado alto o bajo. Inclina el teléfono hasta que la carretera ocupe la mitad inferior."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zielt zu hoch oder zu tief. Neige das Telefon, bis die Straße die untere Hälfte füllt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aponta demasiado alto ou baixo. Incline o telefone até a estrada ocupar a metade inferior."
          }
        }
      }
    },
    "mount.verdict.good": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Good. The horizon will come out level and the lens covers the road."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bon. L'horizon sera droit et l'objectif couvre la route."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bien. El horizonte saldrá recto y el objetivo cubre la carretera."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gut. Der Horizont wird gerade und das Objektiv erfasst die Straße."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bom. O horizonte ficará direito e a objetiva cobre a estrada."
          }
        }
      }
    },
    "mount.verdict.tilted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilted. Turn the cradle until the two lines meet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De travers. Tournez le support jusqu'à ce que les deux lignes se rejoignent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Torcido. Gira el soporte hasta que las dos líneas coincidan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schief. Dreh die Halterung, bis beide Linien zusammenfallen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Torto. Rode o suporte até as duas linhas coincidirem."
          }
        }
      }
    },
    "mount.verdict.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device cannot report its attitude, so only the preview can guide you."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil ne rapporte pas son inclinaison : seule l'image peut vous guider."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no informa de su inclinación: solo la vista previa puede guiarte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät meldet seine Lage nicht — nur die Vorschau kann dich leiten."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este aparelho não reporta a inclinação: só a pré-visualização o pode guiar."
          }
        }
      }
    },
