    "a11y.protect_hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behält die letzten fünf und die nächsten zwei Minuten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps the last five minutes and the next two minutes"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva los últimos 5 minutos y los 2 siguientes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserve les 5 dernières minutes et les 2 minutes suivantes"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda os últimos cinco minutos e os dois seguintes"
