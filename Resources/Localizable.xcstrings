      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dashcam folgt standardmäßig der Gerätesprache. Deine Auswahl hier hat Vorrang und wird gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dashcam follows your device language by default. Your choice here overrides it and is remembered."
