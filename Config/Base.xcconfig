// Base build settings shared by every configuration.
//
// xcconfig gotchas that bit us before, do not "fix" these:
//   - quotes are part of the value, never wrap a value in " "
//   - a literal // starts a comment and truncates the rest of the line, so any URL
//     has to be assembled from SLASH (the $() escape does NOT work here)

SLASH = /

// ---- Identity -------------------------------------------------------------
APP_NAME = Dashcam Pocket
BUNDLE_IDENTIFIER = dashcam.lno.company
DEVELOPMENT_TEAM = 2E6D4Q69QB
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 4

IPHONEOS_DEPLOYMENT_TARGET = 17.0
SWIFT_VERSION = 5.0
SWIFT_STRICT_CONCURRENCY = minimal
SWIFT_EMIT_LOC_STRINGS = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
DEAD_CODE_STRIPPING = YES

// ---- In-app purchase product identifiers ----------------------------------
// Read at runtime from Info.plist, never hardcoded in Swift. Prices always come
// from StoreKit, never from here.
// Fallback only: the authoritative group id is read back from a loaded StoreKit product,
// which is why the local Dashcam.storekit can keep its own id without any conflict.
// This is the real App Store Connect group ("Dashcam Pocket Premium").
SUBSCRIPTION_GROUP_ID = 22377613
PRODUCT_ID_MONTHLY = dashcam.lno.company.monthly
PRODUCT_ID_QUARTERLY = dashcam.lno.company.quarterly
PRODUCT_ID_YEARLY = dashcam.lno.company.yearly

// ---- External links -------------------------------------------------------
// Assembled through $(SLASH) so the // never reads as a comment.
SUPPORT_URL = https:$(SLASH)$(SLASH)crazybeelabs.com$(SLASH)support$(SLASH)
BRAND_URL = https:$(SLASH)$(SLASH)crazybeelabs.com$(SLASH)
TERMS_URL = https:$(SLASH)$(SLASH)crazybeelabs.com$(SLASH)legal$(SLASH)terms$(SLASH)
PRIVACY_URL = https:$(SLASH)$(SLASH)crazybeelabs.com$(SLASH)legal$(SLASH)apps$(SLASH)

// App Store id, filled in once the app record exists in App Store Connect. Used
// for the rating deep link and the "update available" version check.
APPSTORE_APP_ID = 6811080566

// ---- Push (OneSignal) -----------------------------------------------------
// Empty = notifications stay disabled and the SDK is never initialised.
ONESIGNAL_APP_ID =
