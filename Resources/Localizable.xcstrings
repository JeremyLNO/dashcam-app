    "settings.safety.footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufprallerkennung läuft vollständig auf dem Gerät und ignoriert Bodenwellen, starkes Bremsen und das Hantieren mit dem Telefon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Impact detection runs entirely on-device and is tuned to ignore speed bumps, hard braking and the phone being handled."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La detección de impacto funciona en el dispositivo e ignora badenes, frenadas fuertes y manipulaciones del teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La détection de choc fonctionne entièrement sur l'appareil et ignore dos d'âne, freinages appuyés et manipulations du téléphone."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A deteção de impacto funciona totalmente no dispositivo e ignora lombas, travagens fortes e o manuseio do telefone."
          }
        }
      }
    },
