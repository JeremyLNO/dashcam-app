    "onboarding.feature.adaptive": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps plates readable at night and snow white in full sun."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde les plaques lisibles la nuit et la neige blanche en plein soleil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene las matrículas legibles de noche y la nieve blanca a pleno sol."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält Kennzeichen nachts lesbar und Schnee in der Sonne weiß."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém as matrículas legíveis à noite e a neve branca ao sol."
          }
        }
      }
    },
    "onboarding.feature.audio": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Records the sound of the impact, the horn, what was said."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre le bruit du choc, le klaxon, ce qui a été dit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Graba el ruido del impacto, la bocina, lo que se dijo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimmt den Aufprall, die Hupe, das Gesagte auf."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Grava o som do embate, a buzina, o que foi dito."
          }
        }
      }
    },
    "onboarding.feature.auto_export": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves a protected moment to Photos when the drive ends. Needs a subscription."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre un moment protégé dans Photos à la fin du trajet. Abonnement requis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda un momento protegido en Fotos al terminar el trayecto. Requiere suscripción."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichert einen geschützten Moment am Fahrtende in Fotos. Abo nötig."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda um momento protegido em Fotos no fim da viagem. Requer subscrição."
          }
        }
      }
    },
    "onboarding.feature.cabin": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Films the inside of the car alongside the road."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Filme l'habitacle en même temps que la route."
