    "onboarding.1.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The road ahead and the cabin, recorded at the same time."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La route et l'habitacle, filmés en même temps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carretera y el habitáculo, grabados a la vez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Straße und der Innenraum, gleichzeitig aufgenommen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A estrada e o habitáculo, gravados ao mesmo tempo."
          }
        }
      }
    },
    "onboarding.1.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn your iPhone into a dashcam"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transformez votre iPhone en dashcam"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convierte tu iPhone en una dashcam"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach dein iPhone zur Dashcam"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Transforme o seu iPhone numa dashcam"
          }
        }
      }
    },
    "onboarding.2.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record the road ahead and the cabin at the same time."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Filmez la route devant vous et l'habitacle en même temps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Graba la carretera y el habitáculo al mismo tiempo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm die Straße und den Innenraum gleichzeitig auf."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Grave a estrada e o habitáculo ao mesmo tempo."
          }
        }
      }
    },
    "onboarding.2.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two cameras. One drive."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux caméras. Un trajet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos cámaras. Un trayecto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei Kameras. Eine Fahrt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Duas câmaras. Uma viagem."
          }
        }
      }
    },
    "onboarding.3.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collisions, hard brakes and sudden movements are saved automatically."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chocs, freinages brutaux et mouvements soudains sont conservés automatiquement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Impactos, frenadas bruscas y movimientos repentinos se guardan automáticamente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufprälle, starkes Bremsen und plötzliche Bewegungen werden automatisch gesichert."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Embates, travagens bruscas e movimentos súbitos são guardados automaticamente."
          }
        }
      }
    },
    "onboarding.3.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Important moments protect themselves"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les moments importants se protègent seuls"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los momentos importantes se protegen solos"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wichtige Momente schützen sich selbst"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os momentos importantes protegem-se sozinhos"
          }
        }
      }
    },
    "onboarding.4.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stored on your iPhone. No uploads, no accounts, full control."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stockées sur votre iPhone. Aucun envoi, aucun compte, vous décidez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardados en tu iPhone. Sin subidas, sin cuentas, tú decides."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf deinem iPhone gespeichert. Kein Upload, kein Konto, du entscheidest."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardados no seu iPhone. Sem envios, sem contas, você decide."
          }
        }
      }
    },
    "onboarding.4.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your videos stay yours"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos vidéos restent les vôtres"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus vídeos siguen siendo tuyos"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Videos bleiben deine"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os seus vídeos continuam seus"
          }
        }
      }
    },
    "onboarding.5.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dashcam braucht die Kamera zum Filmen. Alles andere ist optional und wird nur bei Bedarf angefragt."
          }
        },
        "en": {
          "stringUnit": {
