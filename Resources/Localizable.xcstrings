    "alert.write_failed.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Videodatei konnte nicht geschrieben werden. Die Aufnahme wurde gestoppt, um bereits Gespeichertes zu schützen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A video file could not be written. Recording has been stopped to protect what was already saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo escribir un archivo de vídeo. La grabación se detuvo para proteger lo ya guardado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un fichier vidéo n'a pas pu être écrit. L'enregistrement a été arrêté pour protéger ce qui est déjà sauvegardé."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível escrever um ficheiro de vídeo. A gravação foi parada para proteger o que já foi guardado."
          }
        }
      }
    },
