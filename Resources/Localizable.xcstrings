      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das lässt sich nicht rückgängig machen. Geschützte Fahrten bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This cannot be undone. Protected drives are kept."
          }
        },
        "es": {
