    "thermal.front_dropped": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Innenraumkamera wurde abgeschaltet. Die Straßenkamera nimmt weiter auf."
          }
