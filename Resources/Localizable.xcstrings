    "alert.storage_full.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht genug freier Speicher zum Aufnehmen. Alles Übrige ist geschützt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is not enough free space to start recording. Everything left is protected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay espacio libre suficiente para grabar. Todo lo que queda está protegido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Espace libre insuffisant pour démarrer l'enregistrement. Tout ce qui reste est protégé."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Espaço livre insuficiente para gravar. Tudo o que resta está protegido."
          }
        }
      }
    },
    "alert.storage_full.stopping": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufnahme gestoppt: kein Speicher mehr. Bereits geschriebene Dateien sind intakt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording stopped: out of space. Files already written are intact."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grabación detenida: sin espacio. Los archivos ya escritos están intactos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrement arrêté : plus d'espace. Les fichiers déjà écrits sont intacts."
          }
        },
