    "library.empty.protected.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe beim Aufnehmen auf Schützen, oder überlasse es der Aufprallerkennung — die Fahrt erscheint dann hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press Protect while recording, or let impact detection do it, and the drive appears here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa Proteger mientras grabas, o deja que lo haga la detección de impacto, y el trayecto aparecerá aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur Protéger pendant l'enregistrement, ou laissez la détection de choc le faire, et le trajet apparaîtra ici."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em Proteger durante a gravação, ou deixe a deteção de impacto fazê-lo, e a viagem aparece aqui."
          }
        }
      }
    },
