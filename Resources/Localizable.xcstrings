    "onboarding.feature.impact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps the ten seconds either side of a collision, by itself."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserve seule les dix secondes autour d'un choc."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda sola los diez segundos alrededor de un impacto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behält von selbst die zehn Sekunden rund um einen Aufprall."
