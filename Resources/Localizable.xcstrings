    "settings.storage.footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei Erreichen eines Limits werden zuerst die ältesten ungeschützten Videos gelöscht. Geschützte Ereignisse werden nie automatisch entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a limit is reached, the oldest unprotected videos are deleted first. Protected events are never removed automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al alcanzar un límite, se eliminan primero los vídeos no protegidos más antiguos. Los eventos protegidos nunca se borran automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand une limite est atteinte, les vidéos non protégées les plus anciennes sont supprimées en premier. Les événements protégés ne sont jamais supprimés automatiquement."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando um limite é atingido, os vídeos não protegidos mais antigos são eliminados primeiro. Os eventos protegidos nunca são removidos automaticamente."
          }
        }
      }
    },
