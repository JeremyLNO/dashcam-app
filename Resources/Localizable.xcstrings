    "settings.recording.footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide Kameras nehmen gleichzeitig auf und werden in Segmente der gewählten Länge geschnitten — ein Absturz kostet höchstens ein Segment."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both cameras record at once and are cut into segments of the chosen length, so a crash costs you at most one segment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambas cámaras graban a la vez y se cortan en segmentos de la duración elegida, así un fallo cuesta como mucho un segmento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les deux caméras enregistrent simultanément et sont découpées en segments de la durée choisie : un plantage vous coûte au plus un segment."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambas as câmaras gravam em simultâneo e são cortadas em segmentos da duração escolhida, pelo que uma falha custa no máximo um segmento."
          }
        }
      }
    },
    "settings.recording.footer.single": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses iPhone kann nicht beide Kameras gleichzeitig aufnehmen, daher wird nur die Straßenkamera genutzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPhone cannot record both cameras at once, so only the road camera is used."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este iPhone no puede grabar ambas cámaras a la vez, así que solo se usa la cámara de carretera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet iPhone ne peut pas enregistrer les deux caméras simultanément : seule la caméra route est utilisée."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este iPhone não consegue gravar ambas as câmaras ao mesmo tempo, por isso só é usada a câmara da estrada."
          }
        }
      }
    },
