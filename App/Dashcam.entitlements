<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- CarPlay Driving Task. Granted by Apple on 2026-09-14 and enabled on the App ID
	     the same evening. Two steps, and the second is the one that is easy to miss:
	     Apple assigns the entitlement to the *account*, then it has to be ticked on
	     each App ID in Certificates, Identifiers & Profiles — the App Store Connect
	     API cannot do it, its capabilityType enum has no CarPlay value at all. Until
	     both are done, asking for the key here fails the *signature*, not the runtime. -->
	<key>com.apple.developer.carplay-driving-task</key>
	<true/>
	<!-- Push. `production` même en Debug : l'environnement APNs est choisi par le profil de
	     provisionnement, pas par cette clé, et une valeur `development` dans un build
	     distribué produit un jeton que le serveur de production refuse en silence — l'app
	     paraît inscrite et ne reçoit jamais rien. -->
	<key>aps-environment</key>
	<string>production</string>
</dict>
</plist>
