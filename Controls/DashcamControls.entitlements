<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The one thing the app and this extension share. It must be byte-identical on both
	     sides and match `DashcamSnapshotStore.appGroup`: a mismatch does not fail to build
	     and raises nothing at runtime — `containerURL(forSecurityApplicationGroupIdentifier:)`
	     simply returns nil, and the widget stays empty for ever. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.company.lno.dashcam</string>
	</array>
</dict>
</plist>
